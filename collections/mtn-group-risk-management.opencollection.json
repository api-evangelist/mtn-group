{
  "opencollection": "1.0.0",
  "info": {
    "name": "MTN Customer Risk Management API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "partyRoleRiskAssessment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates a PartyRoleRiskAssessment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/createApplication"
          },
          "docs": "This operation creates a PartyRoleRiskAssessment entity."
        },
        {
          "info": {
            "name": "Creates a fraudRiskAssessment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/fraudRiskAssessment"
          },
          "docs": "This operation creates a PartyRoleRiskAssessment entity."
        },
        {
          "info": {
            "name": "Creates a Full Vet request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/fullVet"
          },
          "docs": "This operation creates a PartyRoleRiskAssessment entity."
        },
        {
          "info": {
            "name": "Checks application affordability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/affordability"
          },
          "docs": "This operation creates a partyRole eligibility check entity."
        },
        {
          "info": {
            "name": "AVS Decision",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/avs",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "query"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "The date and time when the calling system submits the request to Provenir."
              },
              {
                "name": "bankAccountNo",
                "value": "",
                "type": "query",
                "description": "Bank account number for AVS"
              },
              {
                "name": "bankName",
                "value": "",
                "type": "query",
                "description": "Name of applicant’s Bank"
              },
              {
                "name": "bankAccountType",
                "value": "",
                "type": "query"
              },
              {
                "name": "branchCode",
                "value": "",
                "type": "query",
                "description": "Branch Code of the Bank in which the Bank Account is held"
              }
            ]
          },
          "docs": "This operation creates a PartyRoleRiskAssessment entity"
        },
        {
          "info": {
            "name": "Creates an Order Vet request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/orderVet"
          },
          "docs": "This operation creates a PartyRoleRiskAssessment entity"
        },
        {
          "info": {
            "name": "Request to confirm customer NTU",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/ntu",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "query"
              },
              {
                "name": "requestedStartDate",
                "value": "",
                "type": "query",
                "description": "The partyRoleRiskAssessment to be created"
              }
            ]
          },
          "docs": "Request to confirm the client has not continued with the order.  If order is cancelled before a fullvet call (ApplicationID, Affordability or fraud call) is made then this call needs to be made to Provenir."
        },
        {
          "info": {
            "name": "Query Application ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/partyRoleRiskAssessment/query",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "query"
              },
              {
                "name": "requestedStartDate",
                "value": "",
                "type": "query",
                "description": "The partyRoleRiskAssessment to be created"
              }
            ]
          },
          "docs": "Query Application ID"
        }
      ]
    },
    {
      "info": {
        "name": "fraudManagement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates a RTS request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/rts/order/returnToSender",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "sourceIdentifier",
                "value": "",
                "type": "query",
                "description": "This field denotes the channel that is initiating request to SOA., ex-'Online, USSD, MyMTNApp, Payjoy'"
              }
            ]
          },
          "docs": "This operation creates a RTS request entity for fraud management."
        },
        {
          "info": {
            "name": "Creates a RTS request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/order/returnToSender/dsv",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              }
            ]
          },
          "docs": "This operation creates a RTS request entity for fraud management."
        }
      ]
    }
  ],
  "bundled": true
}