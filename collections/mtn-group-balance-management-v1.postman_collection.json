            "description": {
              "content": "Manages Customer accountBalance information by specifying the 'recipientPhoneNumber'.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":recipientPhoneNumber",
                "topUp"
              ],
