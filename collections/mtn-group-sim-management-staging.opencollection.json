              {
                "name": "x-country-code",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "registrationType",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This operation facilitates the registration of new starter packs for customers, ensuring that all necessary details are captured and processed securely and efficiently for service activation."
        },
