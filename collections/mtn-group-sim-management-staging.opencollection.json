            "url": "https://api.mtn.com/v1/customers/:customerId/sim/resourcePool/reserve",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              },
              {
                "name": "x-country-code",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reserve a resource such as an MSISDN so that it cannot be retrieved in the operation for retrieving available resources (MSISDN's)"
        },
