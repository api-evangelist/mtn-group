{
  "opencollection": "1.0.0",
  "info": {
    "name": "LoyaltySwagger",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Loyalty Member",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/loyaltyProgramMember"
          },
          "docs": "This operation creates a new loyalty program member."
        },
        {
          "info": {
            "name": "Delete Member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/loyaltyProgramMember/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This operation deletes a loyalty program member."
        }
      ]
    },
    {
      "info": {
        "name": "Loyalty Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Member Balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/loyaltyMember/:memberId/loyaltyBalance",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This operation retrieves loyalty program member accounts balance."
        },
        {
          "info": {
            "name": "Update Member Balance",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/loyaltyMember/:memberId/loyaltyBalance",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This operation updates the attributes of a loyalty program member loyalty balance present in the request body and update another members/ point transfer loyalty balance."
        }
      ]
    },
    {
      "info": {
        "name": "Loyalty Burn",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Burn Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/loyaltyMember/:memberId/loyaltyBurn",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This operation retrieves a  loyalty burn transactions of a spesific programme member.Redemtion history"
        },
        {
          "info": {
            "name": "Burn Loyalty Balance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/loyaltyMember/:memberId/loyaltyBurn",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This operation creates a new loyalty burn transaction, Loyaty redemtion."
        }
      ]
    }
  ],
  "bundled": true
}