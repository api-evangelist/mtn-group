{
  "opencollection": "1.0.0",
  "info": {
    "name": "Balance Management V1",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Balance Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Provides the ability to request a TopUp on a specified balanceType",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/accounts/:recipientPhoneNumber/topUp",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "recipientPhoneNumber",
                "value": "",
                "type": "path",
                "description": "PhoneNumber of the recipient for whom the Topup is intended. The format must be E.123"
              }
            ]
          },
          "docs": "Manages Customer accountBalance information by specifying the 'recipientPhoneNumber'."
        }
      ]
    }
  ],
  "bundled": true
}