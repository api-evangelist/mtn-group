    {
      "info": {
        "name": "Process Operations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "To retrieve the booking availability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/bookingAvailability",
            "headers": [
              {
                "name": "targetSystem",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerGroupCode",
                "value": "",
                "type": "query",
                "description": "Customer Group Code"
              },
              {
                "name": "divisionCode",
                "value": "",
                "type": "query",
                "description": "Division Code"
              },
              {
                "name": "townCode",
                "value": "",
                "type": "query",
                "description": "Town Code"
              },
              {
                "name": "suburbName",
                "value": "",
                "type": "query",
                "description": "Suburb Name"
              },
              {
                "name": "clientName",
                "value": "",
                "type": "query",
                "description": "Client/Card holder Name"
              },
              {
                "name": "clientIdPassport",
                "value": "",
                "type": "query",
                "description": "Client SA ID or Passport Number"
