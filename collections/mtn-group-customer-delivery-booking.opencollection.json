      },
      "items": [
        {
          "info": {
            "name": "To retrieve the list of provinces available in the system",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/province",
            "headers": [
              {
                "name": "targetSystem",
                "value": ""
              }
            ]
          },
          "docs": "Province list retrieval"
        },
        {
          "info": {
            "name": "To retrieve the list of towns available in the system",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/town",
            "headers": [
              {
                "name": "targetSystem",
                "value": ""
              }
            ]
          },
          "docs": "Town list retrieval"
        },
        {
          "info": {
            "name": "To retrieve the list of suburb available in the system",
            "type": "http"
          },
          "http": {
            "method": "GET",
