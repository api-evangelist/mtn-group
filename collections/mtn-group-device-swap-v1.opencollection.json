{
  "opencollection": "1.0.0",
  "info": {
    "name": "Device Swap API",
    "version": "0.1.2"
  },
  "items": [
    {
      "info": {
        "name": "Device Swap API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve device swap details.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/deviceSwap"
          },
          "docs": "The Device Swap API uses MSISDN to track changes in the IMEI linked to a subscriber's device"
        },
        {
          "info": {
            "name": "Retrieve last device change details within a certain period.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/deviceSwap/:id",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "msisdn"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Number of days within which the change happened. This is required for South Africa"
              }
            ]
          },
          "docs": "The Device Swap API uses MSISDN to get the last device change that happened in a certain period of time"
        }
      ]
    }
  ],
  "bundled": true
}