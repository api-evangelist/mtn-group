{
  "opencollection": "1.0.0",
  "info": {
    "name": "SIM Swap Verification API",
    "version": "0.1"
  },
  "items": [
    {
      "info": {
        "name": "SIM Swap API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve sim-swap date.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:phoneNumber/simswap-date",
            "headers": [
              {
                "name": "transactionId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "phoneNumber",
                "value": "",
                "type": "path",
                "description": "phoneNumber represented as International  ITU-T E.164."
              },
              {
                "name": "partnerId",
                "value": "",
                "type": "query",
                "description": "partnerId"
              },
              {
                "name": "prefLang",
                "value": "",
                "type": "query",
                "description": "prefLang"
              },
              {
                "name": "requesterId",
                "value": "",
                "type": "query",
                "description": "requesterId"
              }
            ]
          },
          "docs": "Retrieve last sim-swap date from network operator of phoneNumber as identified by customerId (customer's MSISDN)."
        }
      ]
    }
  ],
  "bundled": true
}