{
  "opencollection": "1.0.0",
  "info": {
    "name": "MTN Messaging API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Communication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Receive SMS Responses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/sms",
            "params": [
              {
                "name": "batchSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve SMS messages one by one"
        },
        {
          "info": {
            "name": "Send SMS",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/sms"
          },
          "docs": "Send an SMS Message to a single or multiple mobile number/s.\n"
        },
        {
          "info": {
            "name": "Delivery status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/sms/:messageId/status",
            "params": [
              {
                "name": "messageId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of an SMS message; returned when sending an SMS\n"
              }
            ]
          },
          "docs": "Get delivery status"
        },
        {
          "info": {
            "name": "Register listener",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/sms-listeners"
          },
          "docs": "Callback endpoint to enable the consuming app to receive smses sent to short code assigned to the app"
        },
        {
          "info": {
            "name": "Remove callback listener",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/sms-listeners/:accessCode",
            "params": [
              {
                "name": "accessCode",
                "value": "",
                "type": "path",
                "description": "The id of the registered listener"
              }
            ]
          },
          "docs": "Remove endpoint used to send SMS notifications"
        }
      ]
    }
  ],
  "bundled": true
}